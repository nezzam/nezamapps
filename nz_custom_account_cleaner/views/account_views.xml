<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add server action to delete all accounts -->
    <record id="action_delete_all_accounts" model="ir.actions.server">
        <field name="name">Delete All Accounts</field>
        <field name="model_id" ref="account.model_account_account"/>
        <field name="binding_model_id" ref="account.model_account_account"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">tree</field>
        <field name="state">code</field>
        <field name="code">
action = env['account.cleaner'].delete_all_accounts_with_confirmation()
</field>
    </record>

    <!-- Confirmation Wizard -->
    <record id="model_x_account_delete_confirmation_wizard" model="ir.model">
        <field name="name">Account Deletion Confirmation</field>
        <field name="model">x_account.delete.confirmation.wizard</field>
        <field name="info">Wizard for confirming account deletion</field>
    </record>

    <record id="action_open_account_delete_confirmation_wizard" model="ir.actions.act_window">
        <field name="name">Delete All Chart Accounts</field>
        <field name="res_model">x_account.delete.confirmation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_account_delete_wizard"
              name="Delete Chart of Accounts"
              parent="account.menu_finance_configuration"/>
    <menuitem id="menu_account_delete_confirmation_wizard"
              name="Delete All Chart Accounts"
              parent="menu_account_delete_wizard"
              action="action_open_account_delete_confirmation_wizard"/>



    <record id="x_account_delete_confirmation_wizard_view_form" model="ir.ui.view">
        <field name="name">x_account.delete.confirmation.wizard.form</field>
        <field name="model">x_account.delete.confirmation.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Account Deletion">
                <sheet>
                    <div class="oe_title">
                        <h1>Account Deletion</h1>
                    </div>
                    <group>
                        <div class="alert alert-danger" role="alert">
                            <strong>⚠️ EXTREME WARNING! ⚠️</strong>
                            <br/>
                            You are about to delete <strong><field name="account_count"/></strong> accounts.
                            <br/>
                            This action is <strong>IRREVERSIBLE</strong> and may <strong>BREAK</strong> your accounting system!
                        </div>
                        
                        <div class="alert alert-warning" role="alert">
                            <field name="warning_message" widget="html"/>
                        </div>
                        
                        <div class="alert alert-info" role="alert">
                            <strong>Recommendation:</strong>
                            <ul>
                                <li>Take a database backup before proceeding</li>
                                <li>Consider deactivating accounts instead of deleting</li>
                                <li>Check if accounts have any transactions</li>
                            </ul>
                        </div>
                        
                        <group>
                            <field name="delete_protected"/>
                            <div class="alert alert-danger" role="alert" attrs="{'invisible': [('delete_protected', '=', False)]}">
                                <strong>⚠️ FORCE DELETE ENABLED!</strong>
                                This will delete even system-protected accounts and may cause system instability!
                            </div>
                        </group>

                        <group string="Final Confirmation">
                            <div class="alert alert-danger" role="alert">
                                <strong>Type DELETE in the box below to confirm:</strong>
                                <field name="confirmation_text" placeholder="Type DELETE here"/>
                            </div>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="confirm_delete" string="Delete Accounts" type="object"
                            class="btn-danger" 
                            attrs="{'invisible': [('delete_protected', '=', True)]}"/>
                    <button name="confirm_delete" string="Force Delete All Accounts" type="object"
                            class="btn-danger" 
                            attrs="{'invisible': [('delete_protected', '=', False)]}"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Final Warning Wizard -->
    <record id="model_x_account_final_warning_wizard" model="ir.model">
        <field name="name">Final Deletion Warning</field>
        <field name="model">x_account.final_warning_wizard</field>
        <field name="info">Final warning before force deletion</field>
    </record>

    <record id="x_account_final_warning_wizard_view_form" model="ir.ui.view">
        <field name="name">x_account.final_warning.wizard.form</field>
        <field name="model">x_account.final_warning_wizard</field>
        <field name="arch" type="xml">
            <form string="FINAL WARNING">
                <sheet>
                    <div class="alert alert-danger" style="font-size: 18px; text-align: center;">
                        <strong>⚠️ ⚠️ ⚠️ FINAL WARNING ⚠️ ⚠️ ⚠️</strong>
                    </div>
                    <group>
                        <div class="alert alert-danger" role="alert">
                            <strong style="color: red;">YOU ARE ABOUT TO DELETE <field name="account_count"/> ACCOUNTS INCLUDING SYSTEM-PROTECTED ONES!</strong>
                            <br/><br/>
                            <strong style="color: red;">THIS MAY:</strong>
                            <ul>
                                <li>Break your accounting system completely</li>
                                <li>Make existing transactions invalid</li>
                                <li>Prevent creating new transactions</li>
                                <li>Require database restoration</li>
                            </ul>
                        </div>
                        
                        <div class="alert alert-warning" role="alert">
                            <strong>Type CONFIRM DELETE to proceed:</strong>
                            <br/>
                            <field name="final_confirmation" placeholder="Type CONFIRM DELETE here" style="width: 100%;"/>
                        </div>
                    </group>
                </sheet>
                <footer>
                    <button name="proceed_with_force_delete" string="I UNDERSTAND - PROCEED" 
                            type="object" class="btn-danger" style="font-weight: bold;"/>
                    <button name="cancel" string="CANCEL" 
                            type="object" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Log Model -->
    <record id="model_x_account_cleaner_log" model="ir.model">
        <field name="name">Account Deletion Log</field>
        <field name="model">x_account.cleaner.log</field>
        <field name="info">Log for tracking account deletion operations</field>
    </record>

    <!-- list view for logs -->
    <record id="x_account_cleaner_log_view_list" model="ir.ui.view">
        <field name="name">x_account.cleaner.log.list</field>
        <field name="model">x_account.cleaner.log</field>
        <field name="arch" type="xml">
            <tree string="Deletion Logs">
                <field name="name"/>
                <field name="deletion_date"/>
                <field name="user_id"/>
                <field name="total_accounts"/>
                <field name="deleted_count"/>
                <field name="protected_count"/>
                <button name="action_view_details" type="object" string="View Details" class="btn-info"/>
            </tree>
        </field>
    </record>

    <record id="x_account_cleaner_log_line_view_list" model="ir.ui.view">
        <field name="name">x_account.cleaner.log.line.list</field>
        <field name="model">x_account.cleaner.log.line</field>
        <field name="arch" type="xml">
            <tree string="Deleted Account Lines" create="false" edit="true" delete="false">
                <field name="to_restore"/>
                <field name="account_code"/>
                <field name="account_name"/>
                <field name="account_type"/>
                <field name="company_id"/>
                <field name="deletion_state"/>
                <field name="reason" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="x_account_cleaner_log_view_form" model="ir.ui.view">
        <field name="name">x_account.cleaner.log.form</field>
        <field name="model">x_account.cleaner.log</field>
        <field name="arch" type="xml">
            <form string="Account Deletion Log">
                <header>
                    <button name="action_export_deleted_accounts_xlsx" type="object" string="Export Chart of Accounts" class="btn-secondary"/>
                    <button name="action_restore_marked_accounts" type="object" string="Restore Marked Accounts" class="btn-primary"/>
                    <button name="action_select_all_lines" type="object" string="Select All" class="btn-secondary"/>
                    <button name="action_unselect_all_lines" type="object" string="Unselect All" class="btn-secondary"/>
                    <button name="action_view_details" type="object" string="View Summary" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="deletion_date" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="force_delete" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_accounts" readonly="1"/>
                            <field name="deleted_count" readonly="1"/>
                            <field name="protected_count" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <field name="notes" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="Account Lines">
                            <field name="line_ids" nolabel="1" domain="[('visible_for_restore', '=', True)]">
                                <tree editable="bottom" create="false" delete="false">
                                    <field name="to_restore"/>
                                    <field name="account_code" string="Code"/>
                                    <field name="account_type"/>
                                    <field name="currency_id"/>
                                    <field name="account_name" string="Name"/>
                                    <field name="reconcile"/>
                                    <field name="allowed_journal_ids" widget="many2many_tags"/>
                                    <field name="group_id"/>
                                    <field name="non_trade"/>
                                    <field name="tag_ids" widget="many2many_tags"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="reason" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Legacy Text Summary">
                            <group>
                                <field name="deleted_codes" readonly="1"/>
                                <field name="protected_codes" readonly="1"/>
                                <field name="referenced_codes" readonly="1"/>
                                <field name="failed_codes" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for logs -->
    <record id="action_x_account_cleaner_log" model="ir.actions.act_window">
        <field name="name">Account Deletion Logs</field>
        <field name="res_model">x_account.cleaner.log</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="x_account_cleaner_log_view_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No deletion logs yet.
            </p>
        </field>
    </record>

    <!-- Menu for logs -->
    <menuitem id="menu_account_cleaner_logs" 
              name="Deletion Logs" 
              parent="menu_account_delete_wizard"
              action="action_x_account_cleaner_log"
              sequence="100"/>
</odoo>