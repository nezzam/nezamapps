<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_line_destination" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.line.destination</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_dest_id' and @groups='stock.group_stock_multi_locations']" position="before" groups="stock.group_stock_multi_locations">
                <field name="use_line_destination" string="التحويل لمخازن متعدده" invisible="picking_type_code == 'outgoing'" readonly="state == 'done'" widget="boolean_toggle"/>
            </xpath>

            <xpath expr="//field[@name='location_dest_id' and @groups='stock.group_stock_multi_locations']" position="attributes">
                <attribute name="invisible">picking_type_code == 'outgoing' or use_line_destination</attribute>
            </xpath>

            <xpath expr="//field[@name='move_ids_without_package']/tree/field[@name='location_dest_id']" position="attributes">
                <attribute name="column_invisible">not parent.use_line_destination</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>
</odoo>
