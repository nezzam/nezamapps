<?xml version="1.0" encoding="UTF-8"?>
<!-- Override the default OrderReceipt to inject our custom receipt. -->
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt')]" position="attributes">
            <attribute name="t-if">nzUseDefault</attribute>
        </xpath>
        <xpath expr="//div[hasclass('pos-receipt')]" position="after">
            <div t-if="!nzUseDefault" class="pos-receipt">
                <t t-if="nzDynamicComponent">
                    <t t-component="nzDynamicComponent" t-props="nzTemplateData"/>
                </t>
            </div>
        </xpath>
    </t>
</templates>
