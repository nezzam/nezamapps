<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="nz_receipt_tpl_modern" model="nz.receipt.template">
            <field name="name">Modern Style</field>
            <field name="layout_xml"><![CDATA[
            <div class="pos-receipt nz-custom-receipt">

                <!-- HEADER -->
                <div class="nz-header-block nz-no-drop" style="text-align:center; padding:10px 0;">
                    <t t-if="props.order.config.nz_header_logo">
                        <img t-att-src="'data:image/png;base64,' + props.order.config.nz_header_logo"
                             style="max-width:120px; margin-bottom:5px;"/>
                    </t>
                    <div style="font-size:18px; font-weight:700; margin-top:6px;">
                        [[ company.name ]]
                    </div>
                    <div style="font-size:13px; margin-top:4px;">
                        <div>Phone: <span class="nz-field-placeholder">[[ company.phone ]]</span></div>
                        <div>Email: <span class="nz-field-placeholder">[[ company.email ]]</span></div>
                        <div>Website: <span class="nz-field-placeholder">[[ company.website ]]</span></div>
                    </div>
                </div>

                <!-- ORDER LINES -->
                <div style="margin-top:15px;" class="nz-no-drop">
                    <div style="font-weight:700; border-bottom:1px solid #000; padding-bottom:5px;">
                        Order Details
                    </div>

                    <table class="nz-lines-table" style="width:100%; border-collapse:collapse; margin-top:6px; font-size:14px;">
                        <thead class="nz-no-drop">
                            <tr class="nz-column-dropzone" style="border-bottom:2px solid #000;">
                                <th style="width:45%; text-align:left; font-size:12px; padding:13px;">Product</th>
                                <th style="width:15%; text-align:center; font-size:12px; padding:13px;">Qty</th>
                                <th style="width:20%; text-align:right; font-size:12px; padding:13px;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="props.orderlines and props.orderlines.length">
                                <tr t-foreach="props.orderlines" t-as="orderline" t-key="orderline_index"
                                    style="border-bottom:1px dotted #ccc;">
                                    <td style="padding:4px; width:45%; word-break:break-word; vertical-align:top;">
                                        <t t-esc="orderline.productName"/>
                                    </td>
                                    <td style="padding:4px; text-align:center; width:15%; vertical-align:top;">
                                        <t t-esc="orderline.qty"/>
                                    </td>
                                    <td style="padding:4px; text-align:right; width:20%; vertical-align:top;">
                                        <t t-esc="orderline.price"/>
                                    </td>
                                    <!-- Dynamic columns -->
                                    <td t-foreach="Object.values(orderline._dynamicValues || {})"
                                        t-as="value"
                                        t-key="value_index"
                                        style="text-align:center; vertical-align:top; padding:4px; white-space:nowrap;">
                                        <t t-esc="value || ''"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <!-- TOTALS BOX -->
                <div style="margin-top:18px; padding:10px; border:2px dashed #555; border-radius:6px;">
                    <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
                        <span style="font-weight:600;">Subtotal</span>
                        <span class="nz-field-placeholder">[[ receipt.total_without_tax ]]</span>
                    </div>
                    <div style="display:flex; justify-content:space-between; font-size:18px; font-weight:700;">
                        <span>Total</span>
                        <span class="nz-field-placeholder">[[ receipt.amount_total ]]</span>
                    </div>
                </div>

                <!-- Receipt QR Wrapper -->
                <div class="nz-receipt-qr-wrapper">
                    <div class="nz-receipt-qr-source" style="display:none;">
                        <t t-if="props.data.nz_qr_image">
                            <img t-att-src="'data:image/png;base64,' + props.data.nz_qr_image"
                                 style="width:120px; height:120px; margin:10px auto; display:block;"/>
                        </t>
                    </div>
                </div>

                <!-- Receipt Info -->
                <div style="text-align:center; margin-top:20px; font-size:14px;">
                    <div><t t-esc="props.receipt.name"/></div>
                    <div><t t-esc="props.receipt.date"/></div>
                </div>

                <!-- URL QR Area -->
                <div class="nz-url-qr-area"
                     style="display:flex; justify-content:center; margin:25px 0;">
                </div>

                <!-- Footer -->
                <div style="text-align:center; font-size:14px; margin-top:10px;">
                    Thank you for shopping with us!
                </div>

            </div>]]></field>
        </record>
    </data>
</odoo>
