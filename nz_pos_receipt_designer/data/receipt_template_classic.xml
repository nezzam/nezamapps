<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="nz_receipt_tpl_classic" model="nz.receipt.template">
            <field name="name">Classic Style</field>
            <field name="layout_xml"><![CDATA[
        <div class="pos-receipt nz-custom-receipt">
            <div style="border-radius: inherit;">

                <!-- LOGO -->
                <div style="text-align:center;" class="nz-no-drop">
                    <t t-if="props.order.config.nz_header_logo">
                        <img t-att-src="'data:image/png;base64,' + props.order.config.nz_header_logo"
                              class="nz-receipt-logo" />
                        <br />
                    </t>
                </div>

                <!-- COMPANY INFO -->
                <div class="nz-company-info nz-no-drop">
                    <div style="text-align:center; font-size:13px; height: 90px;">
                        <div>
                            Name :
                            <span class="nz-field-placeholder">[[ company.name ]]</span>
                        </div>
                        <div>
                            Phone :
                            <span class="nz-field-placeholder">[[ company.phone ]]</span>
                        </div>
                        <div>
                            Email :
                            <span class="nz-field-placeholder">[[ company.email ]]</span>
                        </div>
                        <div>
                            Website :
                            <span class="nz-field-placeholder">[[ company.website ]]</span>
                        </div>
                    </div>
                </div>

                <br/><br/><br/>
            </div>

            <div class="nz-drop-zone"></div>

            <!-- ORDER LINES TABLE -->
            <div>
               <table class="nz-lines-table"
                    style="width:100%; border-collapse:collapse; font-size:15px; margin-top:10px;">
                    <thead class="nz-no-drop">
                        <tr style="border-bottom:1px dashed black;" class="nz-column-dropzone">
                            <th style="text-align:left; padding:13px; font-size:12px; width:40%;">Product</th>
                            <th style="text-align:left; padding:13px; font-size:12px; width:10%;">Qty</th>
                            <th style="text-align:left; padding:13px; font-size:12px; width:15%;">Amount</th>
                        </tr>
                    </thead>
                   <tbody>
                    <t t-if="props.orderlines and props.orderlines.length">
                        <tr t-foreach="props.orderlines" t-as="orderline" t-key="orderline_index">
                            <td style="padding:4px; text-align:left; word-break:break-word;">
                                <t t-esc="orderline.productName"/>
                            </td>
                            <td style="padding:4px; text-align:left; font-size:14px;">
                                <t t-esc="orderline.qty"/>
                            </td>
                            <td style="padding:4px; text-align:left; font-size:14px;">
                                <t t-esc="orderline.price"/>
                            </td>
                            <!-- Dynamic columns -->
                            <td t-foreach="Object.values(orderline._dynamicValues || {})"
                                    t-as="value"
                                    t-key="value_index"
                                    style="text-align:center; vertical-align:center; padding:4px; white-space:nowrap;">
                                    <t t-esc="value || ''"/>
                            </td>
                        </tr>
                    </t>
                    </tbody>
                 </table>
            </div>

            <br/><br/>

            <!-- TOTALS -->
            <div id="nzSubtotalRow" class="nz-selectable"
                 style="font-weight:700; justify-content:center;">
                Subtotal :
                <span class="nz-field-placeholder">[[ receipt.total_without_tax ]]</span>
            </div>
            <br/>
            <div id="nzTotalRow" class="nz-selectable"
                 style="font-weight:700; justify-content:center;">
                TOTAL :
                <span class="nz-field-placeholder">[[ receipt.amount_total ]]</span>
            </div>
            <br/><br/>

            <div class="nz-before-footer"></div>

            <!-- Receipt QR Wrapper -->
            <div class="nz-receipt-qr-wrapper">
                <div class="nz-receipt-qr-source" style="display:none;">
                    <t t-if="props.data.nz_qr_image">
                        <img t-att-src="'data:image/png;base64,' + props.data.nz_qr_image"
                             style="width:120px; height:120px; margin:10px auto; display:block;"/>
                    </t>
                </div>
            </div>

            <!-- URL QR Area -->
            <div class="nz-url-qr-area"
                 style="display:flex; justify-content:center; margin:25px 0;">
            </div>

            <br/><br/>

            <!-- Dynamic QR -->
            <div id="nz_dynamic_qr_container"
                 style="justify-content:center; display:flex; margin-bottom:3rem;">
            </div>

            <!-- Footer -->
            <div style="font-size:14px; text-align:center;">
                Thank You... Please Visit Again ...
            </div>
        </div>
        ]]></field>
        </record>
    </data>
</odoo>
