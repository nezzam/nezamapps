<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Tree View (Quotation List) -->
    <record id="sale_order_tree_payment_status" model="ir.ui.view">
        <field name="name">sale.order.tree.payment.status</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_status']" position="after">
                <field name="payment_state"
                       widget="badge"
                       decoration-danger="payment_state == 'no_payment'"
                       decoration-warning="payment_state == 'partial_payment'"
                       decoration-success="payment_state == 'full_payment'"/>
                <field name="paid_amount" optional="hide"/>
                <field name="remaining_amount" optional="hide"/>
                <field name="payment_progress" widget="progressbar" optional="hide"/>
<!--                <field name="payment_progress" widget="percentpie"/>-->
            </xpath>
        </field>
    </record>

    <!-- Form View -->
    <record id="sale_order_form_payment_info" model="ir.ui.view">
        <field name="name">sale.order.form.payment.info</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Smart Button -->
            <xpath expr="//div[@name='button_box']/button[@name='action_view_invoice']" position="inside">
                <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-money" invisible="paid_amount == 0">
                    <field name="paid_amount" widget="monetary"/>
                    <span class="o_stat_text">Paid</span>
                </button>
            </xpath>

            <!-- Payment Information -->
<!--            <xpath expr="//sheet/notebook" position="before">-->
            <xpath expr="//page[@name='other_information']/group" position="inside">
                <group string="Payment Information">
                    <field name="payment_state"
                           widget="badge"
                           decoration-danger="payment_state == 'no_payment'"
                           decoration-warning="payment_state == 'partial_payment'"
                           decoration-success="payment_state == 'full_payment'"/>

                    <field name="paid_amount"/>
                    <field name="remaining_amount"/>
                    <field name="payment_progress" widget="progressbar"/>
                </group>
            </xpath>

        </field>
    </record>

</odoo>
